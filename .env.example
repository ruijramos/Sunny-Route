# ==============================================================================
# Sunny Route - Local Environment Configuration
# ==============================================================================
# Sunny Route works out of the box with 100% FREE, KEYLESS open APIs:
# - Weather: Open-Meteo (No API key needed)
# - Routing: OSRM Open Source Routing Machine (No API key needed)
# - Geocoding: Open-Meteo Geocoding / OpenStreetMap (No API key needed)
#
# All variables below are completely OPTIONAL.
# ==============================================================================

# Optional: Groq API Key for AI trip weather summaries (https://console.groq.com)
# If left blank, Sunny Route generates an automatic smart summary locally.
GROQ_API_KEY=